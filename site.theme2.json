      "type": "timeline", "sort_by": "start_date", "sort_order": "desc", "detail_pages": false
    },
    "experience": {
      "label": "Experience", "slug": "experience", "source": "content/experience.json",
      "type": "timeline", "sort_by": "start_date", "sort_order": "desc", "group_by": "institution", "detail_pages": false
    },
    "awards": {
      "label": "Honors", "slug": "honors", "source": "content/awards.json",
      "type": "timeline", "sort_by": "date", "sort_order": "desc", "detail_pages": false
    },
    "projects": {
      "label": "Projects", "slug": "projects", "source": "content/projects.json",
