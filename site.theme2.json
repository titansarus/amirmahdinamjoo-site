    },
    "service": {
      "label": "Service", "slug": "service", "source": "content/service.json",
      "type": "timeline", "sort_by": "start_date", "sort_order": "desc", "group_by": "institution", "detail_pages": false
    },
    "blog": {
      "label": "Writing", "slug": "blog", "source": "content/blog.json",
      "type": "blog", "sort_by": "date", "sort_order": "desc", "detail_pages": true, "detail_layout": "blog_post"
    },
    "personal_sections": {
      "label": "Personal", "slug": "personal", "source": "content/personal.json",
      "type": "markdown-sections", "detail_pages": true
    }
  },

  "homepage": {
    "sections": [
      { "type": "hero", "source": "content/profile.json" },
      { "type": "collection_preview", "title": "Selected publications", "collection": "publications", "filter": { "selected": true }, "limit": 3, "link_to_full_page": true },
      { "type": "collection_preview", "title": "Projects", "collection": "projects", "filter": { "featured": true }, "limit": 4, "link_to_full_page": true },
      { "type": "collection_preview", "title": "Education", "collection": "education", "limit": 4, "link_to_full_page": true },
      { "type": "collection_preview", "title": "Experience", "collection": "experience", "limit": 4, "link_to_full_page": true },
      { "type": "collection_preview", "title": "Personal", "collection": "personal_sections", "limit": 4, "link_to_full_page": true }
    ]
  },

  "pages": [
    { "title": "Publications", "slug": "publications", "layout": "collection_page", "collections": ["publications"] },
    { "title": "Education", "slug": "education", "layout": "collection_page", "collections": ["education"] },
